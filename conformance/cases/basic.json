{
  "description": "Let/Var/If/Do/Select/Equals/Call basics",
  "source": "ext/api/src/test/scala/queries/BasicFormsSpec.scala, BasicFunctionsSpec.scala",
  "now_micros": 1600000000000000,
  "schema": {
    "collections": [{ "name": "users" }],
    "functions": [
      { "name": "double", "body": { "@query": { "lambda": "x", "expr": { "multiply": [{ "var": "x" }, 2] } } } },
      { "name": "fail", "body": { "@query": { "lambda": "_", "expr": { "abort": "nope" } } } }
    ]
  },
  "cases": [
    { "name": "let binds sequentially", "query": { "let": [{ "a": 1 }, { "b": { "add": [{ "var": "a" }, 1] } }], "in": { "var": "b" } }, "expect": 2 },
    { "name": "let as object (legacy)", "query": { "let": { "a": 1 }, "in": { "var": "a" } }, "expect": 1 },
    { "name": "unbound var", "query": { "var": "nope" }, "error": { "code": "invalid expression", "description": "Variable 'nope' is not defined.", "position": [] } },
    { "name": "if true", "query": { "if": true, "then": "yes", "else": "no" }, "expect": "yes" },
    { "name": "if non-boolean", "query": { "if": 1, "then": "yes", "else": "no" }, "error": { "code": "invalid argument", "description": "Boolean expected, Integer provided.", "position": ["if"] } },
    { "name": "do returns last", "query": { "do": [1, 2, 3] }, "expect": 3 },
    { "name": "do empty", "query": { "do": [] }, "error": { "code": "invalid expression", "description": "Expression list cannot be empty.", "position": ["do"] } },
    { "name": "object evaluates values", "query": { "object": { "a": { "add": [1, 2] }, "b": { "object": { "c": null } } } }, "expect": { "a": 3, "b": { "c": null } } },
    { "name": "raw object is not an expression", "query": { "a": 1 }, "error": { "code": "invalid expression", "description": "No form/function found, or invalid argument keys: { a }.", "position": [] } },
    { "name": "equals numbers across types", "query": { "equals": [1, 1.0] }, "expect": true },
    { "name": "equals many", "query": { "equals": ["a", "a", "a"] }, "expect": true },
    { "name": "equals single is true", "query": { "equals": [1] }, "expect": true },
    { "name": "equals empty", "query": { "equals": [] }, "error": { "code": "invalid argument", "description": "Non-empty array expected.", "position": ["equals"] } },
    { "name": "select path", "query": { "select": ["a", 0, "b"], "from": { "object": { "a": [{ "object": { "b": 7 } }] } } }, "expect": 7 },
    { "name": "select scalar path", "query": { "select": "a", "from": { "object": { "a": 1 } } }, "expect": 1 },
    { "name": "select missing", "query": { "select": ["a", "b"], "from": { "object": { "a": 1 } } }, "error": { "code": "value not found", "description": "Value not found at path [a,b].", "position": ["from"], "status": 404 } },
    { "name": "select default", "query": { "select": ["x"], "from": { "object": {} }, "default": "d" }, "expect": "d" },
    { "name": "select default null", "query": { "select": ["x"], "from": { "object": {} }, "default": null }, "expect": null },
    { "name": "select bad path elem", "query": { "select": [true], "from": { "object": {} } }, "error": { "code": "invalid argument", "description": "String or Integer expected, Boolean provided.", "position": ["select", 0] } },
    { "name": "contains_path", "query": { "contains_path": ["a", "b"], "in": { "object": { "a": { "object": { "b": null } } } } }, "expect": true },
    { "name": "contains_field", "query": { "contains_field": "a", "in": { "object": { "a": 1 } } }, "expect": true },
    { "name": "contains_value object", "query": { "contains_value": 1, "in": { "object": { "a": 1 } } }, "expect": true },
    { "name": "bare lambda is not a form", "query": { "lambda": "x", "expr": { "var": "x" } }, "error": { "code": "invalid expression", "description": "No form/function found, or invalid argument keys: { lambda, expr }.", "position": [] } },
    { "name": "query wraps a lambda into a @query value", "query": { "query": { "lambda": "x", "expr": { "var": "x" } } }, "expect": { "@query": { "lambda": "x", "expr": { "var": "x" }, "api_version": "4" } } },
    { "name": "@query literal without api_version is 2.12", "query": { "@query": { "lambda": "x", "expr": { "var": "x" } } }, "expect": { "@query": { "lambda": "x", "expr": { "var": "x" }, "api_version": "2.12" } }, "todo": "emulator: a `@query` literal without `api_version` gets \"4\"; the server defaults it to \"2.12\"" },
    { "name": "@query literal keeps its api_version", "query": { "@query": { "lambda": "x", "expr": { "var": "x" }, "api_version": "4" } }, "expect": { "@query": { "lambda": "x", "expr": { "var": "x" }, "api_version": "4" } } },
    { "name": "call function", "query": { "call": { "function": "double" }, "arguments": 21 }, "expect": 42 },
    { "name": "call by name", "query": { "call": "double", "arguments": 2 }, "expect": 4 },
    { "name": "call wraps errors", "query": { "call": { "function": "fail" }, "arguments": [] }, "error": { "code": "call error", "description": "Calling the function resulted in an error.", "position": [], "cause": [{ "code": "transaction aborted", "description": "nope", "position": ["expr"] }] } },
    { "name": "call unknown function", "query": { "call": { "function": "missing" }, "arguments": 1 }, "error": { "code": "invalid ref", "description": "Ref refers to undefined function 'missing'", "position": ["call"] } },
    { "name": "abort", "query": { "abort": "stop" }, "error": { "code": "transaction aborted", "description": "stop", "position": [] } },
    { "name": "abort non-string", "query": { "abort": 1 }, "error": { "code": "invalid argument", "description": "String expected, Integer provided.", "position": ["abort"] } },
    { "name": "merge default takes right", "query": { "merge": { "object": { "a": 1, "b": 2 } }, "with": { "object": { "b": 3, "c": 4 } } }, "expect": { "a": 1, "b": 3, "c": 4 } },
    { "name": "merge lambda null removes", "query": { "merge": { "object": { "a": 1, "b": 2 } }, "with": { "object": { "b": 3 } }, "lambda": { "lambda": ["k", "l", "r"], "expr": null } }, "expect": { "a": 1 } },
    { "name": "to_array of object", "query": { "to_array": { "object": { "a": 1, "b": 2 } } }, "expect": [["a", 1], ["b", 2]] },
    { "name": "to_object of pairs", "query": { "to_object": [["a", 1], ["b", 2]] }, "expect": { "a": 1, "b": 2 } },
    { "name": "collection ref", "query": { "collection": "users" }, "expect": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } },
    { "name": "ref constructor", "query": { "ref": { "collection": "users" }, "id": "123" }, "expect": { "@ref": { "id": "123", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } } },
    { "name": "ref constructor numeric id", "query": { "ref": { "collection": "users" }, "id": 123 }, "expect": { "@ref": { "id": "123", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } } },
    { "name": "ref non-numeric id", "query": { "ref": { "collection": "users" }, "id": "abc" }, "error": { "code": "invalid argument", "description": "Number or numeric String expected, non-numeric 'abc' provided.", "position": ["id"] } },
    { "name": "get collection", "query": { "get": { "collection": "users" } }, "expect": { "ref": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } }, "ts": 1600000000000000, "history_days": 0, "name": "users" } },
    { "name": "get missing collection is an unresolved ref", "query": { "get": { "collection": "nope" } }, "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["get"] } },
    { "name": "get missing document", "query": { "get": { "ref": { "collection": "users" }, "id": "1" } }, "error": { "code": "instance not found", "description": "Document not found.", "position": [], "status": 404 } },
    { "name": "get document in missing collection", "query": { "get": { "ref": { "collection": "nope" }, "id": "1" } }, "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["get"] } },
    { "name": "exists false", "query": { "exists": { "ref": { "collection": "users" }, "id": "1" } }, "expect": false },
    { "name": "now is pinned", "query": { "now": null }, "expect": { "@ts": "2020-09-13T12:26:40Z" } },
    { "name": "is_string", "query": { "is_string": "x" }, "expect": true },
    { "name": "is_collection", "query": { "is_collection": { "collection": "users" } }, "expect": true },
    { "name": "and short circuits", "query": { "and": [false, { "abort": "never" }] }, "expect": false },
    { "name": "or short circuits", "query": { "or": [true, { "abort": "never" }] }, "expect": true },
    { "name": "lt chain", "query": { "lt": [1, 2, 3] }, "expect": true },
    { "name": "lt mixed types uses fauna order", "query": { "lt": [1, "a", null] }, "expect": true },
    { "name": "divide by zero", "query": { "divide": [1, 0] }, "error": { "code": "invalid argument", "description": "Illegal division by zero.", "position": [] } },
    { "name": "add promotes to double", "query": { "add": [1, 1.5] }, "expect": 2.5 },
    { "name": "concat with separator", "query": { "concat": ["a", "b"], "separator": "-" }, "expect": "a-b" },
    { "name": "stub fails loudly", "query": { "create_key": { "object": { "role": "admin" } } }, "error": { "code": "not emulated" } }
  ]
}
