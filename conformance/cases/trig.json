{
  "description": "Trigonometric and exponential functions",
  "source": "ext/api/src/test/scala/queries/TrigFunctionsSpec.scala",
  "cases": [
    {"name": "acos decreasing", "query": {"gt": [{"acos": 0}, {"acos": 0.1}, {"acos": 0.2}]}, "expect": true},
    {"name": "acos below pi", "query": {"gt": [3.141592653589793, {"acos": 0.5}]}, "expect": true},
    {"name": "acos 1", "query": {"acos": 1}, "expect": 0.0},
    {"name": "acos out of range", "query": {"acos": 2}, "error": {"code": "invalid argument", "description": "2 must be between -1 and 1 inclusive", "position": []}},
    {"name": "acos out of range double", "query": {"acos": -1.5}, "error": {"code": "invalid argument", "description": "-1.5 must be between -1 and 1 inclusive", "position": []}},
    {"name": "acos string", "query": {"acos": "x"}, "error": {"code": "invalid argument", "description": "Number expected, String provided.", "position": ["acos"]}},
    {"name": "asin increasing", "query": {"gt": [{"asin": 0.2}, {"asin": 0.1}, {"asin": 0.0}]}, "expect": true},
    {"name": "asin odd", "query": {"gt": [{"asin": 0.5}, {"asin": 0}, {"asin": -0.5}]}, "expect": true},
    {"name": "asin 0", "query": {"asin": 0}, "expect": 0.0},
    {"name": "asin out of range", "query": {"asin": 1.0000001}, "error": {"code": "invalid argument", "description": "1.0000001 must be between -1 and 1 inclusive", "position": []}},
    {"name": "atan increasing", "query": {"gt": [{"atan": 2}, {"atan": 0.2}, {"atan": 0.1}, {"atan": 0.0}, {"atan": -10}]}, "expect": true},
    {"name": "atan odd", "query": {"gt": [{"atan": 0.5}, {"atan": 0}, {"atan": -0.5}]}, "expect": true},
    {"name": "atan 0 is double", "query": {"atan": 0}, "expect": 0.0},
    {"name": "cos 0", "query": {"cos": 0}, "expect": 1.0},
    {"name": "cos decreasing", "query": {"gt": [{"cos": 0}, {"cos": 0.2}, {"cos": 0.5}, {"cos": 1}]}, "expect": true},
    {"name": "cosh 0", "query": {"cosh": 0}, "expect": 1.0},
    {"name": "cosh 2", "query": {"trunc": {"cosh": 2}, "precision": 2}, "expect": 3.76},
    {"name": "degrees 0", "query": {"degrees": 0}, "expect": 0.0},
    {"name": "degrees 2", "query": {"trunc": {"degrees": 2}, "precision": 2}, "expect": 114.59},
    {"name": "degrees pi", "query": {"degrees": 3.141592653589793}, "expect": 180.0},
    {"name": "exp 0", "query": {"exp": 0}, "expect": 1.0},
    {"name": "exp increasing", "query": {"gt": [{"exp": 0.5}, {"exp": 0.1}, {"exp": 0.0}, {"exp": -0.5}]}, "expect": true},
    {"name": "hypot 0", "query": {"hypot": 0}, "expect": 0.0},
    {"name": "hypot 0 0", "query": {"hypot": 0, "b": 0}, "expect": 0.0},
    {"name": "hypot 2", "query": {"trunc": {"hypot": 2}, "precision": 2}, "expect": 2.82},
    {"name": "hypot 3 4", "query": {"hypot": 3, "b": 4}, "expect": 5.0},
    {"name": "hypot 3 3", "query": {"trunc": {"hypot": 3, "b": 3}, "precision": 2}, "expect": 4.24},
    {"name": "hypot 4.1 5.1", "query": {"trunc": {"hypot": 4.1, "b": 5.1}, "precision": 2}, "expect": 6.54},
    {"name": "hypot string b", "query": {"hypot": 3, "b": "4"}, "error": {"code": "invalid argument", "description": "Number expected, String provided.", "position": ["b"]}},
    {"name": "ln increasing", "query": {"gt": [{"ln": 100}, {"ln": 0.5}, {"ln": 0.1}]}, "expect": true},
    {"name": "ln 1", "query": {"ln": 1}, "expect": 0.0},
    {"name": "ln 0", "query": {"ln": 0}, "error": {"code": "invalid argument", "description": "0 must be greater than 0", "position": []}},
    {"name": "ln negative double", "query": {"ln": -1.0}, "error": {"code": "invalid argument", "description": "-1.0 must be greater than 0", "position": []}},
    {"name": "log increasing", "query": {"gt": [{"log": 2}, {"log": 0.5}, {"log": 0.2}]}, "expect": true},
    {"name": "log 100", "query": {"log": 100}, "expect": 2.0},
    {"name": "log 0", "query": {"log": 0}, "error": {"code": "invalid argument", "description": "0 must be greater than 0", "position": []}},
    {"name": "pow default exponent", "query": {"pow": 2}, "expect": 4.0},
    {"name": "pow negative base", "query": {"pow": -2}, "expect": 4.0},
    {"name": "pow 2 3", "query": {"pow": 2, "exp": 3}, "expect": 8.0},
    {"name": "pow 10 4", "query": {"pow": 10, "exp": 4}, "expect": 10000.0},
    {"name": "pow 10 -3", "query": {"pow": 10, "exp": -3}, "expect": 0.001},
    {"name": "pow fractional", "query": {"pow": 4, "exp": 0.5}, "expect": 2.0},
    {"name": "pow string exponent", "query": {"pow": 2, "exp": "3"}, "error": {"code": "invalid argument", "description": "Number expected, String provided.", "position": ["exp"]}},
    {"name": "radians 0", "query": {"trunc": {"radians": 0}, "precision": 2}, "expect": 0.0},
    {"name": "radians 50", "query": {"trunc": {"radians": 50}, "precision": 2}, "expect": 0.87},
    {"name": "radians 180", "query": {"radians": 180}, "expect": 3.141592653589793},
    {"name": "sin increasing", "query": {"gt": [{"sin": 1.5}, {"sin": 1}, {"sin": 0.2}]}, "expect": true},
    {"name": "sin 0", "query": {"sin": 0}, "expect": 0.0},
    {"name": "sinh 0", "query": {"trunc": {"sinh": 0}, "precision": 2}, "expect": 0.0},
    {"name": "sinh 2", "query": {"trunc": {"sinh": 2}, "precision": 2}, "expect": 3.62},
    {"name": "tan increasing", "query": {"gt": [{"tan": 1.5}, {"tan": 1}, {"tan": 0.2}]}, "expect": true},
    {"name": "tan 0", "query": {"tan": 0}, "expect": 0.0},
    {"name": "tanh 0", "query": {"trunc": {"tanh": 0}, "precision": 2}, "expect": 0.0},
    {"name": "tanh 100", "query": {"trunc": {"tanh": 100}, "precision": 2}, "expect": 1.0},
    {"name": "sin null", "query": {"sin": null}, "error": {"code": "invalid argument", "description": "Number expected, Null provided.", "position": ["sin"]}}
  ]
}
