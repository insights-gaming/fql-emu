{
  "description": "Create/Update/Replace/Delete of documents and schema documents: document shape, patch semantics, validation, unique constraints, errors and positions (API v4)",
  "source": "ext/api/src/test/scala/queries/WriteFunctionsSpec.scala; ext/model/src/main/scala/ast/functions/WriteFunctions.scala, WriteAdaptor.scala; ext/storage/src/main/scala/doc/Data.scala, ValidationException.scala",
  "now_micros": 1600000000000000,
  "schema": {
    "collections": [{ "name": "users" }, { "name": "posts" }, { "name": "temp", "ttl_days": 1 }, { "name": "accounts" }],
    "indexes": [
      { "name": "posts_by_title", "source": { "@ref": { "id": "posts", "collection": { "@ref": { "id": "collections" } } } }, "terms": [{ "field": ["data", "title"] }] },
      { "name": "accounts_by_email", "unique": true, "source": { "@ref": { "id": "accounts", "collection": { "@ref": { "id": "collections" } } } }, "terms": [{ "field": ["data", "email"] }] }
    ],
    "functions": [
      { "name": "double", "body": { "@query": { "lambda": "x", "expr": { "multiply": [{ "var": "x" }, 2] } } } }
    ]
  },
  "setup": [
    { "create": { "ref": { "collection": "users" }, "id": "1" }, "params": { "object": { "data": { "object": { "name": "ada", "email": "ada@x", "tags": ["a", "b"], "address": { "object": { "city": "London", "zip": "N1" } } } } } } },
    { "create": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "data": { "object": { "name": "bob" } } } } },
    { "create": { "ref": { "collection": "users" }, "id": "3" }, "params": { "object": { "data": { "object": { "name": "eve" } }, "ttl": { "time": "2030-01-01T00:00:00Z" } } } },
    { "create": { "ref": { "collection": "posts" }, "id": "1" }, "params": { "object": { "data": { "object": { "title": "hello" } } } } }
  ],
  "cases": [
    { "name": "create with explicit ref", "query": { "create": { "ref": { "collection": "users" }, "id": "10" }, "params": { "object": { "data": { "object": { "a": 1 } } } } },
      "expect": { "ref": { "@ref": { "id": "10", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "a": 1 } } },
    { "name": "create with numeric id", "query": { "select": ["ref"], "from": { "create": { "ref": { "collection": "users" }, "id": 11 } } },
      "expect": { "@ref": { "id": "11", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } } },
    { "name": "create mints an id", "query": { "let": [{ "d": { "create": { "collection": "users" }, "params": { "object": { "data": { "object": { "a": 1 } } } } } }],
      "in": [{ "select": ["data"], "from": { "var": "d" } }, { "select": ["ts"], "from": { "var": "d" } }, { "exists": { "select": ["ref"], "from": { "var": "d" } } }] },
      "expect": [{ "a": 1 }, 1600000000000000, true] },
    { "name": "create by collection name", "query": { "select": ["data"], "from": { "create": "users", "params": { "object": { "data": { "object": { "a": 1 } } } } } }, "expect": { "a": 1 } },
    { "name": "create without params", "query": { "create": { "ref": { "collection": "users" }, "id": "12" } },
      "expect": { "ref": { "@ref": { "id": "12", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000 } },
    { "name": "create drops unknown top-level fields", "query": { "create": { "ref": { "collection": "users" }, "id": "13" }, "params": { "object": { "data": { "object": { "a": 1 } }, "foo": 1, "ts": 5, "ref": "x" } } },
      "expect": { "ref": { "@ref": { "id": "13", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "a": 1 } } },
    { "name": "create never returns credentials", "query": { "create": { "ref": { "collection": "users" }, "id": "14" }, "params": { "object": { "data": { "object": { "a": 1 } }, "credentials": { "object": { "password": "sekrit" } } } } },
      "expect": { "ref": { "@ref": { "id": "14", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "a": 1 } } },
    { "name": "create with ttl", "query": { "select": ["ttl"], "from": { "create": { "collection": "users" }, "params": { "object": { "ttl": { "time": "2030-01-01T00:00:00Z" } } } } },
      "expect": { "@ts": "2030-01-01T00:00:00.000000000Z" } },
    { "name": "create inherits collection ttl_days", "query": { "select": ["ttl"], "from": { "create": { "collection": "temp" } } },
      "expect": { "@ts": "2020-09-14T12:26:40.000000000Z" } },
    { "name": "create drops nulls", "query": { "select": ["data"], "from": { "create": { "collection": "users" }, "params": { "object": { "data": { "object": { "a": null, "b": [1, null, 2], "c": { "object": { "d": null } } } } } } } },
      "expect": { "b": [1, 2], "c": {} } },
    { "name": "create then get in one transaction", "query": { "do": [{ "create": { "ref": { "collection": "users" }, "id": "15" }, "params": { "object": { "data": { "object": { "a": 1 } } } } }, { "select": ["data", "a"], "from": { "get": { "ref": { "collection": "users" }, "id": "15" } } }] },
      "expect": 1 },
    { "name": "create duplicate ref", "query": { "create": { "ref": { "collection": "users" }, "id": "1" } },
      "error": { "code": "instance already exists", "description": "Document already exists.", "position": ["create"] } },
    { "name": "create in missing collection", "query": { "create": { "collection": "nope" }, "params": { "object": { "data": { "object": {} } } } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["create"] } },
    { "name": "create in missing collection by name", "query": { "create": "nope" },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["create"] } },
    { "name": "create by reserved non-native name", "query": { "create": "events" },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'events'", "position": ["create"] } },
    { "name": "create with ref in missing collection", "query": { "create": { "ref": { "collection": "nope" }, "id": "1" } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["create"] } },
    { "name": "create with non-object data", "query": { "create": { "collection": "users" }, "params": { "object": { "data": 5 } } },
      "error": { "code": "validation failed", "description": "document data is not valid.", "position": ["create"],
        "failures": [{ "field": ["data"], "code": "invalid type", "description": "Invalid type Long, expected type Map." }] } },
    { "name": "create with array data", "query": { "create": { "collection": "users" }, "params": { "object": { "data": [1] } } },
      "error": { "code": "validation failed", "position": ["create"],
        "failures": [{ "field": ["data"], "code": "invalid type", "description": "Invalid type Array, expected type Map." }] } },
    { "name": "create with non-time ttl", "query": { "create": { "collection": "users" }, "params": { "object": { "ttl": 5 } } },
      "error": { "code": "validation failed", "position": ["create"],
        "failures": [{ "field": ["ttl"], "code": "invalid type", "description": "Invalid type Long, expected type Timestamp." }] } },
    { "name": "create with non-object params", "query": { "create": { "collection": "users" }, "params": 5 },
      "error": { "code": "invalid argument", "description": "Object expected, Integer provided.", "position": ["params"] } },
    { "name": "create with non-identifier", "query": { "create": 5 },
      "error": { "code": "invalid argument", "description": "Identifier expected, Integer provided.", "position": ["create"] } },
    { "name": "create validates references", "query": { "create": { "collection": "users" }, "params": { "object": { "data": { "object": { "bar": { "collection": "nope" } } } } } },
      "error": { "code": "validation failed", "description": "document data is not valid.", "position": [],
        "failures": [{ "field": ["data", "bar"], "code": "invalid reference", "description": "Cannot read reference." }] } },
    { "name": "create in the native collections collection", "query": { "create": { "collections": null }, "params": { "object": { "name": "things" } } },
      "expect": { "ref": { "@ref": { "id": "things", "collection": { "@ref": { "id": "collections" } } } }, "ts": 1600000000000000, "history_days": 0, "name": "things" } },
    { "name": "create collection with reserved name", "query": { "create_collection": { "object": { "name": "events" } } },
      "error": { "code": "validation failed", "position": ["create_collection"] } },
    { "name": "create collection without name", "query": { "create_collection": { "object": {} } },
      "error": { "code": "validation failed", "position": ["create_collection"], "failures": [{ "field": ["name"], "code": "value required", "description": "Required value not found." }] } },
    { "name": "create collection with non-string name", "query": { "create_collection": { "object": { "name": 1 } } },
      "error": { "code": "validation failed", "position": ["create_collection"], "failures": [{ "field": ["name"], "code": "invalid type", "description": "Invalid type Long, expected type String." }] } },
    { "name": "unique constraint violation", "query": { "do": [
        { "create": { "collection": "accounts" }, "params": { "object": { "data": { "object": { "email": "a@x" } } } } },
        { "create": { "collection": "accounts" }, "params": { "object": { "data": { "object": { "email": "a@x" } } } } }] },
      "error": { "code": "instance not unique", "description": "document is not unique.", "position": ["do", 1, "create"] } },
    { "name": "unique constraint allows distinct terms", "query": { "do": [
        { "create": { "collection": "accounts" }, "params": { "object": { "data": { "object": { "email": "a@x" } } } } },
        { "select": ["data", "email"], "from": { "create": { "collection": "accounts" }, "params": { "object": { "data": { "object": { "email": "b@x" } } } } } }] },
      "expect": "b@x" },
    { "name": "unique constraint on update", "query": { "do": [
        { "create": { "ref": { "collection": "accounts" }, "id": "1" }, "params": { "object": { "data": { "object": { "email": "a@x" } } } } },
        { "create": { "ref": { "collection": "accounts" }, "id": "2" }, "params": { "object": { "data": { "object": { "email": "b@x" } } } } },
        { "update": { "ref": { "collection": "accounts" }, "id": "2" }, "params": { "object": { "data": { "object": { "email": "a@x" } } } } }] },
      "error": { "code": "instance not unique", "description": "document is not unique.", "position": ["do", 2] } },
    { "name": "unique constraint ignores the document itself", "query": { "do": [
        { "create": { "ref": { "collection": "accounts" }, "id": "1" }, "params": { "object": { "data": { "object": { "email": "a@x" } } } } },
        { "select": ["data"], "from": { "update": { "ref": { "collection": "accounts" }, "id": "1" }, "params": { "object": { "data": { "object": { "n": 1 } } } } } }] },
      "expect": { "email": "a@x", "n": 1 } },

    { "name": "update merges data recursively", "query": { "update": { "ref": { "collection": "users" }, "id": "1" }, "params": { "object": { "data": { "object": { "name": "ada2", "address": { "object": { "zip": null, "country": "UK" } } } } } } },
      "expect": { "ref": { "@ref": { "id": "1", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000,
        "data": { "name": "ada2", "email": "ada@x", "tags": ["a", "b"], "address": { "city": "London", "country": "UK" } } } },
    { "name": "update replaces arrays", "query": { "select": ["data", "tags"], "from": { "update": { "ref": { "collection": "users" }, "id": "1" }, "params": { "object": { "data": { "object": { "tags": ["c"] } } } } } },
      "expect": ["c"] },
    { "name": "update null deletes a field", "query": { "select": ["data"], "from": { "update": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "data": { "object": { "name": null, "x": 1 } } } } } },
      "expect": { "x": 1 } },
    { "name": "update object over scalar replaces", "query": { "select": ["data", "name"], "from": { "update": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "data": { "object": { "name": { "object": { "first": "bob", "last": null } } } } } } } },
      "expect": { "first": "bob" } },
    { "name": "update null data removes data", "query": { "update": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "data": null } } },
      "expect": { "ref": { "@ref": { "id": "2", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000 } },
    { "name": "update ignores non-data fields", "query": { "update": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "foo": 1, "ts": 5 } } },
      "expect": { "ref": { "@ref": { "id": "2", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "name": "bob" } } },
    { "name": "update without params", "query": { "select": ["data"], "from": { "update": { "ref": { "collection": "users" }, "id": "2" } } }, "expect": { "name": "bob" } },
    { "name": "update keeps ttl", "query": { "select": ["ttl"], "from": { "update": { "ref": { "collection": "users" }, "id": "3" }, "params": { "object": { "data": { "object": { "x": 1 } } } } } },
      "expect": { "@ts": "2030-01-01T00:00:00.000000000Z" } },
    { "name": "update is visible to later reads", "query": { "do": [{ "update": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "data": { "object": { "name": "bobby" } } } } }, { "select": ["data", "name"], "from": { "get": { "ref": { "collection": "users" }, "id": "2" } } }] },
      "expect": "bobby" },
    { "name": "update missing document", "query": { "update": { "ref": { "collection": "users" }, "id": "99" }, "params": { "object": { "data": { "object": {} } } } },
      "error": { "code": "instance not found", "description": "Document not found.", "position": ["update"], "status": 404 } },
    { "name": "update in missing collection", "query": { "update": { "ref": { "collection": "nope" }, "id": "1" }, "params": { "object": { "data": { "object": {} } } } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["update"] } },
    { "name": "update non-ref", "query": { "update": "x" },
      "error": { "code": "invalid argument", "description": "Ref expected, String provided.", "position": ["update"] } },
    { "name": "update with non-object data", "query": { "update": { "ref": { "collection": "users" }, "id": "1" }, "params": { "object": { "data": "x" } } },
      "error": { "code": "validation failed", "description": "document data is not valid.", "position": [],
        "failures": [{ "field": ["data"], "code": "invalid type", "description": "Invalid type String, expected type Map." }] } },

    { "name": "replace swaps data wholesale", "query": { "replace": { "ref": { "collection": "users" }, "id": "1" }, "params": { "object": { "data": { "object": { "name": "x" } } } } },
      "expect": { "ref": { "@ref": { "id": "1", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "name": "x" } } },
    { "name": "replace drops ttl not given", "query": { "replace": { "ref": { "collection": "users" }, "id": "3" }, "params": { "object": { "data": { "object": { "name": "eve" } } } } },
      "expect": { "ref": { "@ref": { "id": "3", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "name": "eve" } } },
    { "name": "replace without params empties the document", "query": { "replace": { "ref": { "collection": "users" }, "id": "2" } },
      "expect": { "ref": { "@ref": { "id": "2", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000 } },
    { "name": "replace missing document", "query": { "replace": { "ref": { "collection": "users" }, "id": "99" }, "params": { "object": {} } },
      "error": { "code": "instance not found", "description": "Document not found.", "position": ["replace"] } },
    { "name": "replace in missing collection", "query": { "replace": { "ref": { "collection": "nope" }, "id": "1" }, "params": { "object": {} } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["replace"] } },

    { "name": "delete returns the document", "query": { "delete": { "ref": { "collection": "users" }, "id": "2" } },
      "expect": { "ref": { "@ref": { "id": "2", "collection": { "@ref": { "id": "users", "collection": { "@ref": { "id": "collections" } } } } } }, "ts": 1600000000000000, "data": { "name": "bob" } } },
    { "name": "delete then exists", "query": { "do": [{ "delete": { "ref": { "collection": "users" }, "id": "2" } }, { "exists": { "ref": { "collection": "users" }, "id": "2" } }] }, "expect": false },
    { "name": "delete twice", "query": { "do": [{ "delete": { "ref": { "collection": "users" }, "id": "2" } }, { "delete": { "ref": { "collection": "users" }, "id": "2" } }] },
      "error": { "code": "instance not found", "description": "Document not found.", "position": ["do", 1], "status": 404 } },
    { "name": "delete missing document", "query": { "delete": { "ref": { "collection": "users" }, "id": "99" } },
      "error": { "code": "instance not found", "description": "Document not found.", "position": [], "status": 404 } },
    { "name": "delete in missing collection", "query": { "delete": { "ref": { "collection": "nope" }, "id": "1" } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["delete"] } },
    { "name": "delete non-ref", "query": { "delete": 1 },
      "error": { "code": "invalid argument", "description": "Ref expected, Integer provided.", "position": ["delete"] } },
    { "name": "recreate after delete", "query": { "do": [{ "delete": { "ref": { "collection": "users" }, "id": "2" } }, { "select": ["data"], "from": { "create": { "ref": { "collection": "users" }, "id": "2" }, "params": { "object": { "data": { "object": { "n": 2 } } } } } }] },
      "expect": { "n": 2 } },

    { "name": "update collection data", "query": { "update": { "collection": "posts" }, "params": { "object": { "data": { "object": { "x": 1 } } } } },
      "expect": { "ref": { "@ref": { "id": "posts", "collection": { "@ref": { "id": "collections" } } } }, "ts": 1600000000000000, "history_days": 0, "name": "posts", "data": { "x": 1 } } },
    { "name": "update collection history_days", "query": { "select": ["history_days"], "from": { "update": { "collection": "posts" }, "params": { "object": { "history_days": 5 } } } }, "expect": 5 },
    { "name": "rename collection is not emulated", "query": { "update": { "collection": "posts" }, "params": { "object": { "name": "articles" } } }, "error": { "code": "not emulated" } },
    { "name": "update missing collection", "query": { "update": { "collection": "nope" }, "params": { "object": {} } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["update"] } },
    { "name": "update index data", "query": { "select": ["data"], "from": { "update": { "index": "posts_by_title" }, "params": { "object": { "data": { "object": { "x": 1 } } } } } }, "expect": { "x": 1 } },
    { "name": "update function body", "query": { "do": [{ "update": { "function": "double" }, "params": { "object": { "body": { "query": { "lambda": "x", "expr": { "multiply": [{ "var": "x" }, 3] } } } } } }, { "call": "double", "arguments": 2 }] },
      "expect": 6 },
    { "name": "delete collection", "query": { "delete": { "collection": "posts" } },
      "expect": { "ref": { "@ref": { "id": "posts", "collection": { "@ref": { "id": "collections" } } } }, "ts": 1600000000000000, "history_days": 0, "name": "posts" } },
    { "name": "delete collection removes it", "query": { "do": [{ "delete": { "collection": "posts" } }, [{ "exists": { "collection": "posts" } }, { "exists": { "index": "posts_by_title" } }]] },
      "expect": [false, false] },
    { "name": "delete collection documents are gone", "query": { "do": [{ "delete": { "collection": "posts" } }, { "create_collection": { "object": { "name": "posts" } } }, { "exists": { "ref": { "collection": "posts" }, "id": "1" } }] },
      "expect": false },
    { "name": "delete missing collection", "query": { "delete": { "collection": "nope" } },
      "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'nope'", "position": ["delete"] } },
    { "name": "delete function", "query": { "delete": { "function": "double" } },
      "expect": { "ref": { "@ref": { "id": "double", "collection": { "@ref": { "id": "functions" } } } }, "ts": 1600000000000000, "name": "double",
        "body": { "@query": { "lambda": "x", "expr": { "multiply": [{ "var": "x" }, 2] }, "api_version": "4" } } } },
    { "name": "delete index", "query": { "do": [{ "delete": { "index": "posts_by_title" } }, { "exists": { "index": "posts_by_title" } }] }, "expect": false },

    { "name": "abort rolls back earlier writes", "query": { "do": [{ "create": { "ref": { "collection": "users" }, "id": "20" } }, { "abort": "stop" }] },
      "error": { "code": "transaction aborted", "description": "stop", "position": ["do", 1] } }
  ]
}
