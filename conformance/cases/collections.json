{
  "description": "Map/Foreach/Filter/Reduce, Take/Drop, Prepend/Append, IsEmpty, Count/Sum/Mean/Max/Min/Any/All, Reverse, First/Last over arrays, pages and sets (API v4)",
  "source": "ext/api/src/test/scala/queries/ArrayFunctionsSpec.scala, FilterFunctionSpec.scala, ReduceFunctionsSpec.scala, ReverseFunctionSpec.scala; ext/model/src/main/scala/ast/functions/ArrayFunctions.scala, ReduceFunctions.scala, AbstractFoldFunction.scala",
  "now_micros": 1600000000000000,
  "schema": {
    "collections": [{ "name": "nums" }, { "name": "users" }]
  },
  "setup": [
    { "create": { "ref": { "collection": "nums" }, "id": "1" }, "params": { "object": { "data": { "object": { "value": 1 } } } } },
    { "create": { "ref": { "collection": "nums" }, "id": "2" }, "params": { "object": { "data": { "object": { "value": 2 } } } } },
    { "create": { "ref": { "collection": "nums" }, "id": "3" }, "params": { "object": { "data": { "object": { "value": 3 } } } } }
  ],
  "cases": [
    { "name": "map array", "query": { "map": { "lambda": "x", "expr": { "add": [{ "var": "x" }, 1] } }, "collection": [1, 2, 3] }, "expect": [2, 3, 4] },
    { "name": "map empty array", "query": { "map": { "lambda": "x", "expr": { "abort": "never" } }, "collection": [] }, "expect": [] },
    { "name": "map binds pairs positionally", "query": { "map": { "lambda": ["k", "v"], "expr": { "concat": [{ "var": "k" }, { "var": "v" }] } }, "collection": [["a", "1"], ["b", "2"]] }, "expect": ["a1", "b2"] },
    { "name": "map nested pattern", "query": { "map": { "lambda": ["a", ["b", "c"]], "expr": [{ "var": "c" }, { "var": "b" }, { "var": "a" }] }, "collection": [[1, [2, 3]]] }, "error": { "code": "invalid expression", "description": "String expected, Array provided.", "position": ["map", "lambda", 1] }, "todo": "emulator: accepts a nested array in a lambda parameter pattern; v4 only allows a string or an array of strings" },
    { "name": "map one-element pattern binds a scalar", "query": { "map": { "lambda": ["x"], "expr": { "var": "x" } }, "collection": [1, 2] }, "expect": [1, 2] },
    { "name": "map ignore pattern", "query": { "map": { "lambda": "_", "expr": 0 }, "collection": [1, 2] }, "expect": [0, 0] },
    { "name": "map closes over let", "query": { "let": [{ "n": 10 }], "in": { "map": { "lambda": "x", "expr": { "add": [{ "var": "x" }, { "var": "n" }] } }, "collection": [1] } }, "expect": [11] },
    { "name": "map arity error", "query": { "map": { "lambda": ["a", "b"], "expr": { "var": "a" } }, "collection": [1] }, "error": { "code": "invalid argument", "description": "Lambda expects an array with 2 elements. Array contains 1.", "position": ["map", "lambda"] } },
    { "name": "map arity error on longer array", "query": { "map": { "lambda": ["a", "b"], "expr": { "var": "a" } }, "collection": [[1, 2, 3]] }, "error": { "code": "invalid argument", "description": "Lambda expects an array with 2 elements. Array contains 3.", "position": ["map", "lambda"] } },
    { "name": "map body error position", "query": { "map": { "lambda": "x", "expr": { "add": [{ "var": "x" }, "s"] } }, "collection": [1] }, "error": { "code": "invalid argument", "description": "Number expected, String provided.", "position": ["map", "expr", "add", 1] } },
    { "name": "lambda in a let binding is not a form", "query": { "let": [{ "f": { "lambda": "x", "expr": { "var": "x" } } }], "in": { "map": { "var": "f" }, "collection": [1] } }, "error": { "code": "invalid expression", "description": "No form/function found, or invalid argument keys: { lambda, expr }.", "position": ["let", 0, "f"] } },
    { "name": "map lambda must be a lambda", "query": { "map": 10, "collection": [1] }, "error": { "code": "invalid expression", "description": "Lambda expected, Integer provided.", "position": ["map"] } },
    { "name": "map over non-iterable", "query": { "map": { "lambda": "x", "expr": { "var": "x" } }, "collection": "abc" }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, String provided.", "position": ["collection"] } },
    { "name": "map over collection ref", "query": { "map": { "lambda": "x", "expr": { "var": "x" } }, "collection": { "collection": "nums" } }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, Collection Ref provided.", "position": ["collection"] } },
    { "name": "map over set is an error", "query": { "map": { "lambda": "x", "expr": { "var": "x" } }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } }, "error": { "code": "invalid argument", "description": "Array or Page expected, Set provided.", "position": ["collection"] } },
    { "name": "map over page keeps cursors", "query": { "map": { "lambda": "r", "expr": { "select": ["data", "value"], "from": { "get": { "var": "r" } } } }, "collection": { "paginate": { "documents": { "collection": "nums" } } } }, "expect": { "data": [1, 2, 3] } },

    { "name": "foreach returns the collection", "query": { "foreach": { "lambda": "x", "expr": { "add": [{ "var": "x" }, 1] } }, "collection": [1, 2] }, "expect": [1, 2] },
    { "name": "foreach performs writes", "query": { "do": [{ "foreach": { "lambda": "i", "expr": { "create": { "ref": { "collection": "users" }, "id": { "var": "i" } } } }, "collection": [7, 8] }, { "exists": { "ref": { "collection": "users" }, "id": "8" } }] }, "expect": true },
    { "name": "foreach over set is an error", "query": { "foreach": { "lambda": "x", "expr": { "var": "x" } }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } }, "error": { "code": "invalid argument", "description": "Array or Page expected, Set provided.", "position": ["collection"] } },

    { "name": "filter array", "query": { "filter": { "lambda": "x", "expr": { "gt": [{ "var": "x" }, 1] } }, "collection": [1, 2, 3] }, "expect": [2, 3] },
    { "name": "filter pairs", "query": { "filter": { "lambda": ["k", "v"], "expr": { "equals": [{ "var": "v" }, 1] } }, "collection": [["a", 1], ["b", 2]] }, "expect": [["a", 1]] },
    { "name": "filter arity error", "query": { "filter": { "lambda": ["i", "oops"], "expr": true }, "collection": [1, 2, 3, 4, 5] }, "error": { "code": "invalid argument", "description": "Lambda expects an array with 2 elements. Array contains 1.", "position": ["filter", "lambda"] } },
    { "name": "filter non-boolean result", "query": { "filter": { "lambda": "x", "expr": 1 }, "collection": [1, 2] }, "error": { "code": "invalid argument", "description": "Boolean expected, Integer provided.", "position": [0] } },
    { "name": "filter set stays lazy", "query": { "is_set": { "filter": { "lambda": "x", "expr": true }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } } }, "expect": true },
    { "name": "filter set disallows writes", "query": { "filter": { "lambda": "x", "expr": { "create_collection": { "object": { "name": "things" } } } }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } }, "error": { "code": "invalid argument", "description": "Invalid lambda. Lambda in this context may not write or call a user function.", "position": ["filter"] } },
    { "name": "filter set disallows calls", "query": { "filter": { "lambda": "x", "expr": { "call": "f", "arguments": [] } }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } }, "error": { "code": "invalid argument", "description": "Invalid lambda. Lambda in this context may not write or call a user function.", "position": ["filter"] } },
    { "name": "filter set allows replace_str", "query": { "is_set": { "filter": { "lambda": "x", "expr": { "equals": [{ "replace_str": "a", "find": "a", "replace": "b" }, "b"] } }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } } }, "error": {"code": "invalid expression", "description": "No form/function found, or invalid argument keys: { replace_str, find, replace }.", "position": ["is_set","filter","expr","equals",0]}, "todo": "emulator: accepts the API-Unstable-only name `replace_str` (v4 has only `replacestr`)" },
    { "name": "filter set allows replacestr", "query": { "is_set": { "filter": { "lambda": "x", "expr": { "equals": [{ "replacestr": "a", "find": "a", "replace": "b" }, "b"] } }, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } } }, "expect": true },
    { "name": "filter page", "query": { "filter": { "lambda": "r", "expr": { "equals": [{ "var": "r" }, { "ref": { "collection": "nums" }, "id": "2" }] } }, "collection": { "paginate": { "documents": { "collection": "nums" } } } },
      "expect": { "data": [{ "@ref": { "id": "2", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } }] } },

    { "name": "reduce sums", "query": { "reduce": { "lambda": ["acc", "v"], "expr": { "add": [{ "var": "acc" }, { "var": "v" }] } }, "initial": 0, "collection": [1, 2, 3] }, "expect": 6 },
    { "name": "reduce empty returns initial", "query": { "reduce": { "lambda": ["acc", "v"], "expr": { "abort": "never" } }, "initial": "init", "collection": [] }, "expect": "init" },
    { "name": "reduce single param gets the pair", "query": { "reduce": { "lambda": "p", "expr": { "select": [1], "from": { "var": "p" } } }, "initial": 0, "collection": [1, 2] }, "expect": 2 },
    { "name": "reduce concat", "query": { "reduce": { "lambda": ["acc", "v"], "expr": { "concat": [{ "var": "acc" }, { "var": "v" }] } }, "initial": "", "collection": ["Fauna", "DB"] }, "expect": "FaunaDB" },
    { "name": "reduce lambda must be a lambda", "query": { "reduce": 10, "initial": 0, "collection": 0 }, "error": { "code": "invalid expression", "description": "Lambda expected, Integer provided.", "position": ["reduce"] } },
    { "name": "reduce non-iterable", "query": { "reduce": { "lambda": "x", "expr": { "var": "x" } }, "initial": 0, "collection": "string" }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, String provided.", "position": ["collection"] } },
    { "name": "reduce arity", "query": { "reduce": { "lambda": ["x", "y", "z"], "expr": { "var": "x" } }, "initial": 0, "collection": [1, 2, 3] }, "error": { "code": "invalid argument", "description": "Lambda expects an array with 3 elements. Array contains 2.", "position": ["reduce", "lambda"] } },
    { "name": "reduce body error", "query": { "reduce": { "lambda": ["acc", "value"], "expr": { "add": [{ "var": "acc" }, { "var": "value" }] } }, "initial": 0, "collection": [1, 2, "str", 3] }, "error": { "code": "invalid argument", "description": "Number expected, String provided.", "position": ["reduce", "expr", "add", 1] } },
    { "name": "reduce over set", "query": { "reduce": { "lambda": ["acc", "r"], "expr": { "add": [{ "var": "acc" }, { "select": ["data", "value"], "from": { "get": { "var": "r" } } }] } }, "initial": 0, "collection": { "documents": { "collection": "nums" } } }, "expect": 6 },
    { "name": "reduce over page wraps result", "query": { "reduce": { "lambda": ["acc", "r"], "expr": { "add": [{ "var": "acc" }, 1] } }, "initial": 0, "collection": { "paginate": { "documents": { "collection": "nums" } } } }, "expect": { "data": [3] } },

    { "name": "prepend array", "query": { "prepend": [1, 2], "collection": [3] }, "expect": [1, 2, 3] },
    { "name": "prepend to empty", "query": { "prepend": [], "collection": [1, 2] }, "expect": [1, 2] },
    { "name": "prepend scalar", "query": { "prepend": 1, "collection": [2] }, "expect": [1, 2] },
    { "name": "prepend to non-array", "query": { "prepend": [1], "collection": 2 }, "error": { "code": "invalid argument", "description": "Array expected, Integer provided.", "position": ["collection"] } },
    { "name": "append array", "query": { "append": [1], "collection": [2] }, "expect": [2, 1] },
    { "name": "append scalar", "query": { "append": 1, "collection": [2] }, "expect": [2, 1] },
    { "name": "append to non-array", "query": { "append": [1], "collection": 2 }, "error": { "code": "invalid argument", "description": "Array expected, Integer provided.", "position": ["collection"] } },

    { "name": "take", "query": { "take": 2, "collection": [1, 2, 3] }, "expect": [1, 2] },
    { "name": "take negative", "query": { "take": -1, "collection": [1, 2, 3] }, "expect": [] },
    { "name": "take more than length", "query": { "take": 10, "collection": [1, 2, 3] }, "expect": [1, 2, 3] },
    { "name": "take zero", "query": { "take": 0, "collection": [1, 2, 3] }, "expect": [] },
    { "name": "take non-array", "query": { "take": 1, "collection": 1 }, "error": { "code": "invalid argument", "description": "Array or Page expected, Integer provided.", "position": ["collection"] } },
    { "name": "take set is not allowed in v4", "query": { "take": 1, "collection": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } }, "error": { "code": "invalid argument", "description": "Array or Page expected, Set provided.", "position": ["collection"] } },
    { "name": "take non-integer count", "query": { "take": "x", "collection": [1] }, "error": { "code": "invalid argument", "description": "Integer expected, String provided.", "position": ["take"] } },
    { "name": "take negative on page", "query": { "take": -1, "collection": { "paginate": { "documents": { "collection": "nums" } } } }, "expect": { "data": [] } },
    { "name": "drop", "query": { "drop": 2, "collection": [1, 2, 3] }, "expect": [3] },
    { "name": "drop negative", "query": { "drop": -1, "collection": [1, 2, 3] }, "expect": [1, 2, 3] },
    { "name": "drop more than length", "query": { "drop": 5, "collection": [1, 2, 3] }, "expect": [] },
    { "name": "drop non-array", "query": { "drop": 1, "collection": 1 }, "error": { "code": "invalid argument", "description": "Array or Page expected, Integer provided.", "position": ["collection"] } },

    { "name": "is_empty empty", "query": { "is_empty": [] }, "expect": true },
    { "name": "is_empty non-empty", "query": { "is_empty": [1] }, "expect": false },
    { "name": "is_nonempty", "query": { "is_nonempty": [1] }, "expect": true },
    { "name": "is_nonempty empty", "query": { "is_nonempty": [] }, "expect": false },
    { "name": "is_empty non-iterable", "query": { "is_empty": 1 }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, Integer provided.", "position": ["is_empty"] } },
    { "name": "is_nonempty non-iterable", "query": { "is_nonempty": 1 }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, Integer provided.", "position": ["is_nonempty"] } },
    { "name": "is_empty set", "query": { "is_empty": { "documents": { "collection": "nums" } } }, "expect": false },
    { "name": "is_empty page", "query": { "is_empty": { "paginate": { "documents": { "collection": "nums" } } } }, "expect": false },

    { "name": "count array", "query": { "count": [1, 2, 3] }, "expect": 3 },
    { "name": "count empty", "query": { "count": [] }, "expect": 0 },
    { "name": "count non-iterable", "query": { "count": 1 }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, Integer provided.", "position": ["count"] } },
    { "name": "count set", "query": { "count": { "documents": { "collection": "nums" } } }, "expect": 3 },
    { "name": "count page wraps result", "query": { "count": { "paginate": { "documents": { "collection": "nums" } } } }, "expect": { "data": [3] } },

    { "name": "sum longs", "query": { "sum": [1, 2, 3] }, "expect": 6 },
    { "name": "sum promotes to double", "query": { "sum": [1, 2.5] }, "expect": 3.5 },
    { "name": "sum of doubles stays double", "query": { "sum": [1.0, 2.0] }, "expect": 3.0 },
    { "name": "sum empty is long zero", "query": { "sum": [] }, "expect": 0 },
    { "name": "sum non-number", "query": { "sum": [10, "str", 20] }, "error": { "code": "invalid argument", "description": "Number expected, String provided.", "position": ["sum"] } },
    { "name": "sum non-iterable", "query": { "sum": "x" }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, String provided.", "position": ["sum"] } },
    { "name": "mean longs is double", "query": { "mean": [1, 2] }, "expect": 1.5 },
    { "name": "mean exact is still double", "query": { "mean": [2, 2] }, "expect": 2.0 },
    { "name": "mean empty", "query": { "mean": [] }, "error": { "code": "invalid argument", "description": "Non-empty array expected.", "position": ["mean"] } },
    { "name": "mean non-number", "query": { "mean": [10, "str", 20] }, "error": { "code": "invalid argument", "description": "Number expected, String provided.", "position": ["mean"] } },

    { "name": "max longs", "query": { "max": [1, 2, 4, 8] }, "expect": 8 },
    { "name": "max strings", "query": { "max": ["A", "B", "C", "D"] }, "expect": "D" },
    { "name": "max string over number", "query": { "max": ["A", 1] }, "expect": "A" },
    { "name": "max mixed numbers", "query": { "max": [-1.2, 12, 100] }, "expect": 100 },
    { "name": "max dates", "query": { "max": [{ "date": "1970-01-01" }, { "date": "1930-01-01" }] }, "expect": { "@date": "1970-01-01" } },
    { "name": "max nested iterable", "query": { "max": [[1, 5, 2]] }, "expect": 5 },
    { "name": "max of null", "query": { "max": [null] }, "expect": null },
    { "name": "max empty", "query": { "max": [] }, "error": { "code": "invalid argument", "description": "Non-empty array expected.", "position": ["max"] } },
    { "name": "max unresolved refs", "query": { "max": [{ "collection": "coll" }, { "index": "idx" }] }, "error": { "code": "invalid ref", "description": "Ref refers to undefined collection 'coll'", "position": ["max"] } },
    { "name": "max set", "query": { "max": { "documents": { "collection": "nums" } } }, "expect": { "@ref": { "id": "3", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } },
    { "name": "min longs", "query": { "min": [1, 2, 4, 8] }, "expect": 1 },
    { "name": "min number under string", "query": { "min": ["A", 1] }, "expect": 1 },
    { "name": "min negative", "query": { "min": [1, -10, 16] }, "expect": -10 },
    { "name": "min empty", "query": { "min": [] }, "error": { "code": "invalid argument", "description": "Non-empty array expected.", "position": ["min"] } },

    { "name": "any", "query": { "any": [false, true] }, "expect": true },
    { "name": "any empty", "query": { "any": [] }, "expect": false },
    { "name": "any non-boolean", "query": { "any": [true, "x"] }, "error": { "code": "invalid argument", "description": "Boolean expected, String provided.", "position": ["any"] } },
    { "name": "all", "query": { "all": [true, true] }, "expect": true },
    { "name": "all false", "query": { "all": [true, false] }, "expect": false },
    { "name": "all empty", "query": { "all": [] }, "expect": true },
    { "name": "all checks every element", "query": { "all": [false, 1] }, "error": { "code": "invalid argument", "description": "Boolean expected, Integer provided.", "position": ["all"] } },

    { "name": "reverse array", "query": { "reverse": [1, 2, 3] }, "expect": [3, 2, 1] },
    { "name": "reverse set stays a set", "query": { "is_set": { "reverse": { "@set": { "documents": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } } }, "expect": true },
    { "name": "reverse non-iterable", "query": { "reverse": 1 }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, Integer provided.", "position": ["reverse"] } },
    { "name": "reverse page", "query": { "reverse": { "paginate": { "documents": { "collection": "nums" } } } }, "expect": { "data": [
      { "@ref": { "id": "3", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } },
      { "@ref": { "id": "2", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } },
      { "@ref": { "id": "1", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } }
    ] } },

    { "name": "first", "query": { "first": [1, 2, 3] }, "expect": 1 },
    { "name": "last", "query": { "last": [1, 2, 3] }, "expect": 3 },
    { "name": "first empty", "query": { "first": [] }, "error": { "code": "invalid argument", "description": "Non-empty array expected.", "position": ["first"] } },
    { "name": "last empty", "query": { "last": [] }, "error": { "code": "invalid argument", "description": "Non-empty array expected.", "position": ["last"] } },
    { "name": "first non-iterable", "query": { "first": 1 }, "error": { "code": "invalid argument", "description": "Array, Set, or Page expected, Integer provided.", "position": ["first"] } },
    { "name": "first of page is an error", "query": { "first": { "paginate": { "documents": { "collection": "nums" } } } }, "error": { "code": "invalid argument", "description": "Set or Array expected, Page provided.", "position": ["first"] } },
    { "name": "first of set", "query": { "first": { "documents": { "collection": "nums" } } }, "expect": { "@ref": { "id": "1", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } },
    { "name": "last of set", "query": { "last": { "documents": { "collection": "nums" } } }, "expect": { "@ref": { "id": "3", "collection": { "@ref": { "id": "nums", "collection": { "@ref": { "id": "collections" } } } } } } },
    { "name": "first of empty set", "query": { "first": { "documents": { "collection": "users" } } }, "error": { "code": "invalid argument", "description": "Non-empty set expected.", "position": ["first"] } }
  ]
}
