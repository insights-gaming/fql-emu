{
  "name": "@insights-gaming/fql-emu",
  "version": "0.1.1",
  "description": "FQL v4 query emulator (Rust/wasm) with a drop-in faunadb Client.query shim for fast unit tests. Not a database.",
  "repository": {
    "type": "git",
    "url": "https://github.com/insights-gaming/fql-emu.git",
    "directory": "js"
  },
  "homepage": "https://github.com/insights-gaming/fql-emu#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:wasm": "bash ../scripts/build-wasm.sh",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-cjs.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "differential": "npm run build && node dist/differential.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "faunadb": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "faunadb": "^4.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
